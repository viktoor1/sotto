<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<title>Sotto #637 — Interactive investigation</title>
<style>
:root{--bg:#0c0f13;--panel:#12161d;--raised:#181e27;--line:#27313e;--muted:#8d9aab;--text:#e4eaf2;--cyan:#60d9ee;--cyan-bg:#15323b;--red:#f18c95;--red-bg:#352128;--green:#80d6ad;--green-bg:#19332b;--amber:#e5bd77;--amber-bg:#342c20;--mono:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;--sans:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:13px/1.5 var(--sans)}button,select{font:inherit}button{cursor:pointer;color:inherit}button:disabled{cursor:default;opacity:.4}button,select,a{touch-action:manipulation}button:focus-visible,a:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--cyan);outline-offset:4px}button{border:1px solid var(--line);border-radius:6px;background:var(--raised);padding:7px 11px;transition:background .15s,border-color .15s,color .15s}button:hover:not(:disabled){background:#222c38;border-color:#46566a}button[aria-pressed=true]{color:var(--cyan);border-color:#347586;background:var(--cyan-bg)}a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline}button svg{width:15px;height:15px;vertical-align:-3px;fill:none;stroke:currentColor;stroke-width:1.6}select{color:var(--text);background:var(--raised);border:1px solid var(--line);border-radius:6px;padding:8px 30px 8px 10px;max-width:100%}kbd{font:11px var(--mono);padding:2px 5px;border:1px solid #394453;border-bottom-width:2px;border-radius:4px;color:#b6c2d1;background:#19212b}code{font-family:var(--mono)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.muted{color:var(--muted)}.mono{font-family:var(--mono)}.eyebrow{font:10px/1.4 var(--mono);letter-spacing:1.4px;color:var(--muted);text-transform:uppercase}.tiny{font-size:11px}.icon-button{padding:6px 9px}.flat{background:transparent}.separator{width:1px;height:18px;background:var(--line)}
.topbar{height:57px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 25px;gap:12px;background:#10141a}.brand{display:flex;align-items:center;gap:11px;font-size:12px;font-weight:650;letter-spacing:1.3px}.brandmark{width:25px;height:25px;display:grid;place-items:center;color:var(--cyan);border:1px solid #35606b;border-radius:6px;font:18px var(--mono)}.brand span:last-child{font-weight:400;color:var(--muted)}.top-actions{display:flex;align-items:center;gap:9px}.offline{color:var(--green);font:10px var(--mono);letter-spacing:.5px;display:flex;align-items:center;gap:6px}.dot{width:5px;height:5px;border-radius:50%;background:currentColor}.hero{padding:23px 26px 21px;display:flex;align-items:center;justify-content:space-between;gap:18px}.issue-label{font:10px var(--mono);letter-spacing:1.2px;color:var(--cyan);margin-bottom:7px}.hero h1{font-size:25px;line-height:1.2;letter-spacing:-.6px;font-weight:600;margin:0 0 7px}.hero p{margin:0;color:var(--muted);font-size:12px}.snapshot{display:flex;gap:22px;align-items:center}.stat strong{display:block;font:18px var(--mono);color:#c9d7e6;letter-spacing:-.5px}.stat span{font:9px var(--mono);letter-spacing:1px;color:var(--muted)}.stat.pending strong{color:var(--amber)}.workspace{margin:0 16px;display:grid;grid-template-columns:minmax(280px,.9fr) minmax(400px,1.65fr) minmax(280px,.85fr);gap:10px;height:calc(100dvh - 232px);min-height:550px}.panel{border:1px solid var(--line);border-radius:9px;min-width:0;min-height:0;background:var(--panel);display:flex;flex-direction:column;overflow:hidden}.panel-title{height:46px;padding:0 15px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:9px;flex-shrink:0}.panel-title h2{margin:0;font-size:11px;font-weight:600;letter-spacing:.2px;display:flex;gap:8px;align-items:center}.panel-index{font:10px var(--mono);color:#65768a}.panel-title .tiny{color:var(--muted);font-family:var(--mono)}
.graph-options{padding:12px;border-bottom:1px solid var(--line);flex-shrink:0}.graph-options label{display:block;margin-bottom:5px}.graph-options select{width:100%;font-size:12px}.scenario-description{font-size:11px;color:var(--muted);margin:7px 1px 0;min-height:17px}.graph-canvas{position:relative;flex:1;min-height:250px;background-color:#10151c;background-image:radial-gradient(#2b3542 1px,transparent 1px);background-size:18px 18px;overflow:hidden}.graph-canvas svg{display:block;width:100%;height:100%;touch-action:none;cursor:grab}.graph-canvas svg.dragging{cursor:grabbing}.graph-world{transform-origin:0 0}.edge{fill:none;stroke:#394657;stroke-width:1.5;opacity:.38;transition:stroke .22s,opacity .22s}.edge.traversed{stroke:var(--cyan);opacity:.85;stroke-width:2}.edge.failure.traversed{stroke:var(--red)}.edge.recovery.traversed{stroke:var(--green)}.edge.hypothesis{stroke-dasharray:5 5}.edge-label{font:10px var(--mono);fill:#8e9cad}.flow-node{cursor:pointer;outline:none;transition:opacity .2s}.flow-node rect.body{fill:#1a222d;stroke:#3a485b;stroke-width:1}.flow-node .node-title{fill:#e2e9f3;font:600 14px var(--sans)}.flow-node .node-subtitle{fill:#8e9daf;font:9px var(--mono);letter-spacing:.15px}.flow-node .node-number{fill:#8e9daf;font:10px var(--mono)}.flow-node .node-dot{fill:#8e9daf}.flow-node.failure .node-dot{fill:var(--red)}.flow-node.failure rect.body{stroke:#70414b}.flow-node.recovery .node-dot{fill:var(--green)}.flow-node.pending .node-dot{fill:var(--amber)}.flow-node.ghost rect.body{stroke-dasharray:4 4}.flow-node.active rect.body{fill:#17313b;stroke:var(--cyan);stroke-width:2;filter:url(#selected-glow)}.flow-node.active.failure rect.body{fill:#352128;stroke:var(--red)}.flow-node.active.recovery rect.body{fill:#17342c;stroke:var(--green)}.flow-node.active.pending rect.body{fill:#342c20;stroke:var(--amber)}.flow-node:hover rect.body,.flow-node:focus-visible rect.body{stroke:var(--cyan);stroke-width:2}.flow-node.visited .node-number{fill:var(--cyan)}.graph-tools{position:absolute;bottom:10px;left:10px;right:10px;display:flex;justify-content:space-between;gap:5px;pointer-events:none}.tool-cluster{display:flex;align-items:center;gap:2px;padding:3px;background:#111923f0;border:1px solid var(--line);border-radius:7px;pointer-events:auto}.tool-cluster button{border-color:transparent;background:transparent;padding:4px 8px;min-width:26px}.zoom-label{font:10px var(--mono);width:34px;text-align:center;color:var(--muted)}.graph-legend{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:9px 12px;border-top:1px solid var(--line);font-size:9px;letter-spacing:.4px;font-family:var(--mono);color:var(--muted)}.legend-item{display:flex;gap:5px;align-items:center}.legend-item i{height:5px;width:5px;border-radius:50%;display:inline-block}.graph-navigation{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:11px 12px;border-top:1px solid var(--line)}.graph-navigation button{padding:5px 10px;font-size:11px}.step-count{font:10px var(--mono);color:var(--muted)}
.mode-tabs{display:flex;gap:2px;border:1px solid var(--line);background:#0e131a;padding:3px;border-radius:7px}.mode-tabs button{border:0;background:transparent;font:10px var(--mono);padding:4px 10px;border-radius:4px;color:var(--muted)}.mode-tabs button[aria-selected=true]{background:#203540;color:var(--cyan)}.inspector-summary{padding:16px 17px 13px;border-bottom:1px solid var(--line)}.summary-top{display:flex;align-items:center;gap:7px;margin-bottom:8px}.pill{font:9px/1 var(--mono);letter-spacing:.6px;display:inline-block;padding:5px 6px;border-radius:4px;border:1px solid #3a4858;color:#b8c8d8;white-space:nowrap}.pill.observed{background:#1b2939;border-color:#344b68;color:#a7c9ed}.pill.inferred{background:var(--amber-bg);border-color:#665131;color:var(--amber)}.pill.proposed{background:#153136;border-color:#31585f;color:var(--cyan)}.pill.verified{background:var(--green-bg);border-color:#315c49;color:var(--green)}.node-category{font:9px var(--mono);color:var(--muted)}.inspector-summary h3{margin:0 0 7px;font-size:18px;line-height:1.3;font-weight:550;letter-spacing:-.2px}.explanation{margin:0;font-size:12px;line-height:1.65;color:#aebdce}.source-header{display:flex;justify-content:space-between;gap:10px;padding:12px 14px 10px;align-items:flex-start;border-bottom:1px solid #202a36;background:#10151c}.source-path{font:10px/1.5 var(--mono);color:#b8c8d8;overflow-wrap:anywhere}.source-function{font:10px/1.5 var(--mono);color:#718399;margin-top:3px}.code-actions{display:flex;gap:5px;flex-shrink:0}.code-actions button{font-size:10px;padding:4px 6px}.code-scope{padding:7px 14px;border-bottom:1px solid #202a36;color:#8ca0b6;background:#121a23;font:9px/1.5 var(--mono)}.code-scope.proposed{color:var(--amber);background:#231f18}.code-view{overflow:auto;flex:1;background:#0e131a;min-height:180px;padding:11px 0 16px;scrollbar-color:#3e4c5d #0e131a;scrollbar-width:thin;tab-size:2}.code-line{display:flex;min-height:21px;font:11px/21px var(--mono);border-left:2px solid transparent}.code-line .line-no{width:47px;flex-shrink:0;color:#526176;user-select:none;text-align:right;padding-right:12px;font:10px/21px var(--mono);position:sticky;left:0;background:#0e131a}.code-line .diff-mark{width:16px;flex-shrink:0;color:#72849c;user-select:none}.code-line .code-text{white-space:pre;padding-right:16px;min-width:0;color:#c5d0df}.code-view.wrap .code-text{white-space:pre-wrap;overflow-wrap:anywhere;flex:1}.code-line.highlight{background:#19313d70;border-left-color:#4995a9}.code-line.highlight .line-no{background:#14232e;color:#8eb5c9}.code-line.add{background:#123b2960;border-left-color:#3a9468}.code-line.add .line-no{background:#11261f;color:#6eac8a}.code-line.add .diff-mark{color:var(--green)}.code-line.remove{background:#4b202860;border-left-color:#b45c69}.code-line.remove .line-no{background:#27191f;color:#bb7c86}.code-line.remove .diff-mark{color:var(--red)}.token-keyword{color:#c5a1ef}.token-string{color:#9fcaad}.token-comment{color:#6b8191;font-style:italic}.token-number{color:#e3ba83}.token-function{color:#7ccbe4}.token-type{color:#d6c08d}.token-tag{color:#e8a3a5}.code-footer{padding:8px 13px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:9px;font:9px var(--mono);color:#72849a}.scope-dot{color:var(--amber)}
.context-tabs{display:flex;gap:15px;height:46px;align-items:center}.context-tabs button{padding:14px 0;border:0;border-radius:0;border-bottom:2px solid transparent;background:transparent;font:11px var(--sans);color:var(--muted)}.context-tabs button[aria-selected=true]{border-bottom-color:var(--cyan);color:var(--text)}.context-scroll{overflow:auto;flex:1;padding:15px;scrollbar-width:thin;scrollbar-color:#3e4c5d var(--panel)}.context-section{margin-bottom:20px}.context-section h3{margin:0 0 10px;font:9px var(--mono);letter-spacing:1.4px;color:#8495ab}.trace-item{padding:0 0 12px 13px;border-left:1px solid #334354;margin-left:3px;position:relative}.trace-item:before{content:"";width:5px;height:5px;border-radius:50%;position:absolute;left:-3px;top:5px;background:#547189}.trace-item:last-child{padding-bottom:0;border-left-color:transparent}.trace-item:last-child:before{background:var(--cyan)}.trace-label{display:block;font:9px var(--mono);color:#7692a8;margin-bottom:4px;letter-spacing:.5px}.trace-value{font-size:11px;color:#b3c2d2;line-height:1.6;overflow-wrap:anywhere}.evidence-card{border:1px solid #2c3948;background:#151d27;border-radius:6px;padding:11px;margin-bottom:8px}.card-top{display:flex;justify-content:space-between;gap:6px;align-items:center;margin-bottom:7px}.evidence-card h4{font-size:11px;font-weight:550;margin:0 0 6px}.evidence-card p{font-size:11px;color:#9aaec2;line-height:1.65;margin:0}.evidence-card details{margin-top:8px;font-size:10px}.evidence-card summary{cursor:pointer;color:#8ed9e9;list-style:none}.evidence-card summary:before{content:"+ ";font-family:var(--mono)}.evidence-card details[open] summary:before{content:"− "}.mini-output{font:10px/1.7 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;color:#b6c7d9;padding:9px;background:#0d141d;border-radius:4px;margin:8px 0 0}.source-reference{font:9px var(--mono);color:#70869e;margin-top:8px;overflow-wrap:anywhere}.status-key{display:grid;gap:7px}.status-key>div{display:flex;gap:8px;align-items:flex-start;font-size:10px;color:#92a4b8}.status-key .pill{min-width:72px;text-align:center}.acceptance{display:grid;gap:8px;margin:0;padding:0;list-style:none}.acceptance li{font-size:11px;color:#a6b5c7;display:flex;gap:8px}.acceptance li:before{content:"○";color:var(--amber);font-family:var(--mono)}.checkpoint{border-left:1px solid #34475b;padding:0 0 20px 14px;margin-left:4px;position:relative}.checkpoint:before{content:"";position:absolute;left:-4px;top:4px;width:7px;height:7px;border-radius:50%;background:#3f6f83}.checkpoint:last-child{border-left-color:transparent}.checkpoint h4{font-size:12px;margin:6px 0}.checkpoint p{margin:0;color:#96a9bf;font-size:11px;line-height:1.65}.checkpoint .when{font:9px var(--mono);color:#6f8aa4;display:block;margin-top:6px}.journal-boundary{padding:11px;border:1px solid #3f4137;border-radius:5px;background:#23241c;color:#c3bb9b;font-size:10px;margin-bottom:19px}.footbar{min-height:45px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 22px;font:9px var(--mono);color:#7d90a6}.footbar-left,.footbar-right{display:flex;align-items:center;gap:12px}.footbar button{font-size:9px;padding:3px 6px}.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(12px);background:#1f3640;border:1px solid #458397;border-radius:6px;color:#d4f6ff;padding:9px 16px;opacity:0;pointer-events:none;transition:opacity .15s,transform .15s;z-index:20;font-size:12px}.toast.visible{opacity:1;transform:translateX(-50%) translateY(0)}dialog{background:#131c27;color:var(--text);border:1px solid #3b4c61;border-radius:12px;padding:0;max-width:min(720px,92vw);width:620px;max-height:85dvh;box-shadow:0 25px 80px #0009}dialog::backdrop{background:#030609c9;backdrop-filter:blur(4px)}.dialog-head{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.dialog-head h2{font-size:15px;margin:0}.dialog-body{padding:20px;overflow:auto;max-height:calc(85dvh - 70px);font-size:12px}.shortcut-grid{display:grid;grid-template-columns:1fr auto;gap:11px;align-items:center;color:#a7b9cb}.dialog-body pre{font:11px/1.7 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.dialog-body p{color:#a6b7cb;line-height:1.7}.notes-button{margin-top:10px;width:100%;font-size:10px}.selection-pulse{animation:selection-in .18s ease-out}@keyframes selection-in{from{opacity:.45;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}
@media(min-width:1650px){.workspace{grid-template-columns:minmax(330px,1fr) minmax(560px,1.7fr) minmax(330px,.9fr)}.code-line{font-size:12px;line-height:23px;min-height:23px}.code-line .line-no{line-height:23px}.explanation{font-size:13px}.hero h1{font-size:29px}}
@media(max-width:1120px){.workspace{grid-template-columns:300px minmax(0,1fr);height:auto;min-height:0}.graph-panel,.inspector-panel{height:740px}.context-panel{grid-column:1/-1;max-height:550px}.context-scroll{display:grid;grid-template-columns:1fr 1fr;gap:20px}.context-section{margin-bottom:0}.hero{padding:20px}.snapshot{gap:14px}.topbar{padding:0 20px}.footbar{margin:10px 20px;flex-wrap:wrap}.context-scroll.journal-view{display:block}}
@media(max-width:700px){.topbar{padding:0 13px;height:52px}.brand{font-size:10px;gap:7px}.brand span:last-child{display:none}.top-actions{gap:5px}.offline{font-size:8px}.top-actions button{font-size:10px;padding:5px 7px}.hero{display:block;padding:20px 15px 17px}.hero h1{font-size:24px}.hero p{font-size:11px}.snapshot{margin-top:16px;gap:24px}.stat strong{font-size:15px}.workspace{grid-template-columns:1fr;margin:0 9px;gap:12px}.graph-panel{height:590px}.inspector-panel{height:760px}.context-panel{grid-column:auto;max-height:none}.context-scroll{display:block;max-height:650px}.context-section{margin-bottom:20px}.panel-title{padding:0 11px}.mode-tabs button{padding:4px 7px}.inspector-summary{padding:14px}.source-header{padding:11px}.source-path{font-size:9px}.code-line{font-size:10px}.code-line .line-no{width:37px;font-size:9px;padding-right:8px}.footbar{font-size:8px;margin:14px;align-items:flex-start;flex-direction:column}.footbar-right{flex-wrap:wrap}.graph-options{padding:10px}.code-footer{font-size:8px}.source-function{font-size:9px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
/*__FOCUS_STYLES__*/
</style>
</head>
<body>
<header class="topbar">
  <div class="brand"><div class="brandmark" aria-hidden="true">s.</div>SOTTO <span>/ INVESTIGATIONS</span></div>
  <div class="top-actions"><span class="offline"><span class="dot"></span>OFFLINE ARTIFACT</span><span class="separator" aria-hidden="true"></span><button id="export-evidence" class="flat" title="Download the shareable, task-specific evidence snapshot">Export evidence ↓</button><button id="help-button" class="icon-button" aria-label="Keyboard shortcuts and help">?</button></div>
</header>
<section class="hero" aria-labelledby="page-heading">
  <div><div class="issue-label">ISSUE 637 / PERSONAL PAYER TRANSFER</div><h1 id="page-heading">A failure with no way back.</h1><p>Follow administrator discovery from a UI event to a missing recovery path.</p></div>
  <div class="snapshot" aria-label="Investigation status"><div class="stat"><strong>12 <span style="letter-spacing:0">/ 12</span></strong><span>RECORDED BASELINE</span></div><div class="stat pending"><strong>Pending</strong><span>REGRESSION REPRODUCTION</span></div><div class="stat"><strong id="source-commit">07f32e5</strong><span>SOURCE SNAPSHOT</span></div></div>
</section>
<main class="workspace">
  <section class="panel graph-panel" aria-labelledby="flow-heading">
    <div class="panel-title"><h2 id="flow-heading"><span class="panel-index">01</span> Flow graph</h2><span class="tiny" id="graph-kind">CURRENT PATH</span></div>
    <div class="graph-options"><label for="scenario" class="eyebrow">Investigation route</label><select id="scenario"></select><p id="scenario-description" class="scenario-description"></p></div>
    <div class="graph-canvas" id="graph-canvas"><svg id="graph-svg" aria-label="Interactive execution flow. Select a node to inspect its code and evidence." role="group"><defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#5b768a"/></marker><marker id="arrow-active" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#60d9ee"/></marker><filter id="selected-glow" x="-25%" y="-25%" width="150%" height="150%"><feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#60d9ee" flood-opacity=".12"/></filter></defs><g id="graph-world" class="graph-world"></g></svg>
      <div class="graph-tools"><div class="tool-cluster"><button id="zoom-out" aria-label="Zoom out">−</button><span id="zoom-label" class="zoom-label">100%</span><button id="zoom-in" aria-label="Zoom in">+</button></div><div class="tool-cluster"><button id="fit-view" aria-label="Fit graph to view" title="Fit graph (F)">Fit</button></div></div>
    </div>
    <div class="graph-legend"><span class="legend-item"><i style="background:var(--red)"></i>FAILURE</span><span class="legend-item"><i style="background:var(--green)"></i>RECOVERY</span><span class="legend-item"><i style="background:var(--amber)"></i>PENDING</span><span style="margin-left:auto">DRAG TO PAN</span></div>
    <div class="graph-navigation"><button id="previous" title="Previous step (←)">← Back</button><span id="step-count" class="step-count"></span><button id="next" title="Next step (→)">Next →</button></div>
  </section>
  <section class="panel inspector-panel" aria-labelledby="inspector-heading">
    <div class="panel-title"><h2 id="inspector-heading"><span class="panel-index">02</span> Code inspector</h2><div class="mode-tabs" role="tablist" aria-label="Code view"><button role="tab" id="mode-current" data-mode="current" aria-selected="true" aria-controls="inspector-content">Current</button><button role="tab" id="mode-proposed" data-mode="proposed" aria-selected="false" aria-controls="inspector-content">Proposed</button><button role="tab" id="mode-diff" data-mode="diff" aria-selected="false" aria-controls="inspector-content">Diff</button></div></div>
    <div id="inspector-content" role="tabpanel" aria-labelledby="mode-current" style="display:contents">
      <div class="inspector-summary" id="inspector-summary"><div class="summary-top"><span id="node-evidence" class="pill"></span><span id="node-category" class="node-category"></span></div><h3 id="node-title"></h3><p id="explanation" class="explanation"></p></div>
      <div class="source-header"><div style="min-width:0"><button id="source-path" class="source-path" aria-label="Read complete source file"></button><div id="source-function" class="source-function"></div></div><div class="code-actions"><button id="wrap-code" aria-pressed="true" title="Toggle code wrapping">Wrap</button><button id="copy-code" title="Copy the displayed excerpt">Copy</button></div></div>
      <div id="code-scope" class="code-scope"></div><div class="focus-toolbar"><span id="focus-description" class="focus-description"></span><button id="expand-context" aria-expanded="false">Expand full context</button></div><div id="code-view" class="code-view wrap" tabindex="0" aria-label="Source-code excerpt"></div><div class="code-footer"><span id="code-count"></span><span id="code-origin"></span></div>
    </div>
  </section>
  <aside class="panel context-panel" aria-labelledby="context-heading">
    <div class="panel-title"><h2 id="context-heading" class="sr-only">Context and evidence</h2><div class="context-tabs" role="tablist" aria-label="Context view"><button role="tab" id="tab-evidence" data-context="evidence" aria-selected="true" aria-controls="context-content">Context / Evidence</button><button role="tab" id="tab-journal" data-context="journal" aria-selected="false" aria-controls="context-content">Journal</button></div></div><div id="context-content" class="context-scroll" role="tabpanel" aria-labelledby="tab-evidence"></div>
  </aside>
</main>
<footer class="footbar"><div class="footbar-left"><span class="scope-dot">●</span><span>REVIEW ARTIFACT · PROPOSAL NOT APPLIED</span><span class="separator" aria-hidden="true"></span><span id="footer-selection"></span></div><div class="footbar-right"><span><kbd>←</kbd> <kbd>→</kbd> step</span><span><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> view</span><span><kbd>F</kbd> fit</span><button id="original-notes" class="flat">Original analysis ↗</button></div></footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div><div class="sr-only" id="selection-announcement" aria-live="polite"></div>
<dialog id="info-dialog" aria-labelledby="dialog-heading"><div class="dialog-head"><h2 id="dialog-heading">Investigation guide</h2><button id="close-dialog" class="icon-button" aria-label="Close dialog">×</button></div><div class="dialog-body" id="dialog-body"></div></dialog>
<script id="investigation-data" type="application/json">__INVESTIGATION_DATA__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('investigation-data').textContent);
const $=id=>document.getElementById(id);
const NODES=new Map(DATA.nodes.map(n=>[n.id,n]));
const graphLabels={select:'Choose organisation',reset:'Clear dependent values',request:'Load administrators',api:'GET /orgs/:id/members',error:'Members request fails',blocked:'No retry path',retry:'Retry same organisation',pending:'Wait · block overlap',success:'Members available',empty:'Empty success',review:'Review payer transfer',selection:'Change organisation',isolation:'Separate error domains',tests:'Read recorded baseline',coverage:'Add regression tests'};
const CHECKPOINTS=new Map(DATA.checkpoints.map(c=>[c.id,c]));
const SCENARIOS=new Map(DATA.scenarios.map(s=>[s.id,s]));
const state={mode:'current',scenario:'failure',cursor:0,context:'evidence',wrap:true,zoom:1,x:0,y:0,positions:new Map(),graphWidth:320,graphHeight:500};
let toastTimer,pan=null,resizeTimer;
const escapeHTML=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function pill(label){return `<span class="pill ${label.toLowerCase()}">${escapeHTML(label)}</span>`;}
function currentRoute(){const s=SCENARIOS.get(state.scenario);return state.mode==='current'?s.current:s.proposed;}
function selectedNode(){return NODES.get(currentRoute()[state.cursor]);}
function behaviourStatus(node){if(state.mode!=='current')return 'PROPOSED';if(node.id==='empty')return 'INFERRED';if(['selection','isolation'].includes(node.id))return 'OBSERVED';return node.evidence;}
function statusHelp(){return `<div class="status-key"><div>${pill('OBSERVED')}<span>Read directly in source or the recorded journal. Not a new runtime reproduction.</span></div><div>${pill('INFERRED')}<span>Behaviour derived from source; the regression test remains pending.</span></div><div>${pill('PROPOSED')}<span>Review-only code or intended behaviour. Not applied or regression-tested.</span></div><div>${pill('VERIFIED')}<span>A recorded baseline check passed. Its scope is stated explicitly.</span></div></div>`;}
function highlight(text){
 const expression=/(\/\/.*$|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|`(?:\\.|[^`\\])*`|\b(?:async|await|function|const|let|return|if|else|try|catch|finally|throw|new|export|import|from|type|interface|void|true|false|null|undefined)\b|\b\d+(?:\.\d+)?\b|\b[A-Za-z_$][\w$]*(?=\s*\()|\b(?:Member|Org|Error|Promise|PayerTransferQuote)\b|<\/?[A-Za-z][\w.]*)/g;
 let result='',last=0;
 for(const match of text.matchAll(expression)){const token=match[0];result+=escapeHTML(text.slice(last,match.index));let kind='keyword';if(token.startsWith('//'))kind='comment';else if(/^["'`]/.test(token))kind='string';else if(/^\d/.test(token))kind='number';else if(token.startsWith('<'))kind='tag';else if(/^(Member|Org|Error|Promise|PayerTransferQuote)$/.test(token))kind='type';else if(/^[A-Za-z_$]/.test(token)&&!(/^(async|await|function|const|let|return|if|else|try|catch|finally|throw|new|export|import|from|type|interface|void|true|false|null|undefined)$/.test(token)))kind='function';result+=`<span class="token-${kind}">${escapeHTML(token)}</span>`;last=match.index+token.length;}
 return result+escapeHTML(text.slice(last));
}
function renderCode(node){renderFocusedCode(node);}
function renderInspector(){const node=selectedNode();$('node-evidence').className='pill '+behaviourStatus(node).toLowerCase();$('node-evidence').textContent=behaviourStatus(node);$('node-category').textContent=node.subtitle;$('node-title').textContent=node.title;$('explanation').textContent=node.explanation;renderCode(node);document.querySelector('.inspector-panel').dataset.kind=node.kind;$('footer-selection').textContent=node.id+' / '+state.mode;$('selection-announcement').textContent=`${node.title}. ${behaviourStatus(node)}. ${state.mode} code.`;}
function evidenceCard(c){return `<article class="evidence-card"><div class="card-top">${pill(c.status)}<span class="tiny muted mono">${escapeHTML(c.anchor)}</span></div><h4>${escapeHTML(c.title)}</h4><p>${escapeHTML(c.detail)}</p>${c.command||c.output?`<details><summary>Command & recorded output</summary>${c.command?`<pre class="mini-output">$ ${escapeHTML(c.command)}</pre>`:''}<pre class="mini-output">${escapeHTML(c.output)}</pre></details>`:''}<div class="source-reference">${escapeHTML(c.when)}</div></article>`;}
function renderContext(){
 const node=selectedNode(),current=node.current,trace=node.traces[state.mode==='current'?'current':'proposed'];
 $('context-content').setAttribute('aria-labelledby','tab-'+state.context);$('context-content').classList.toggle('journal-view',state.context==='journal');
 if(state.context==='journal'){
  $('context-content').innerHTML=`<div class="journal-boundary">Selected task checkpoints only. The complete task journal is preserved independently as <code>task-journal.md</code>. This shareable HTML embeds no unrelated workspace activity.</div>${DATA.checkpoints.map(c=>`<article class="checkpoint">${pill(c.status)}<h4>${escapeHTML(c.title)}</h4><p>${escapeHTML(c.detail)}</p><span class="when">${escapeHTML(c.when)} · journal / ${escapeHTML(c.anchor)}</span>${node.checkpoints.includes(c.id)?'<span class="source-reference" style="display:block;color:var(--cyan)">↳ CONNECTED TO SELECTED STEP</span>':''}</article>`).join('')}<div class="context-section"><h3>ARTIFACT SNAPSHOT</h3><p class="tiny muted">Built ${escapeHTML(DATA.builtAt)}. Source commit ${escapeHTML(DATA.commit)}. The original analysis is embedded under Original analysis.</p></div>`;
 }else{

  $('context-content').innerHTML=`<section class="context-section"><h3>EVENT → STATE → RESULT</h3><div class="trace-item"><span class="trace-label">01 / UI EVENT OR ASYNC RESULT</span><div class="trace-value">${escapeHTML(trace.event)}</div></div><div class="trace-item"><span class="trace-label">02 / STATE TRANSITION</span><div class="trace-value mono">${escapeHTML(trace.transition)}</div>${renderModelTransition(node)}</div><div class="trace-item"><span class="trace-label">03 / OBSERVABLE RESULT</span><div class="trace-value">${escapeHTML(trace.result)}</div></div><div class="source-reference">${escapeHTML(current.path)}:${current.start}–${current.end}<br>Behaviour status: ${behaviourStatus(node)}. This is a trace model, not a live Sotto session.</div></section><section class="context-section"><h3>CONNECTED EVIDENCE</h3>${node.checkpoints.map(id=>evidenceCard(CHECKPOINTS.get(id))).join('')}</section><section class="context-section"><h3>EVIDENCE KEY</h3>${statusHelp()}</section>${node.id==='coverage'?`<section class="context-section"><h3>REGRESSION MATRIX · ALL PENDING</h3><ul class="acceptance">${DATA.acceptance.map(x=>`<li>${escapeHTML(x)}</li>`).join('')}</ul></section>`:''}`;
 }
}
function makeSVG(tag,attrs={},text){const el=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const[k,v]of Object.entries(attrs))el.setAttribute(k,String(v));if(text!==undefined)el.textContent=text;return el;}
function graphIds(){const scenario=SCENARIOS.get(state.scenario),route=currentRoute(),ids=[...new Set(route)];const extras=state.mode==='current'?(['failure','recovery','repeat'].includes(state.scenario)?['retry']:[]):scenario.extra;for(const id of extras)if(!ids.includes(id))ids.push(id);return ids;}
function graphEdges(){const route=currentRoute(),edges=[];for(let i=1;i<route.length;i++)edges.push({from:route[i-1],to:route[i],traversed:i<=state.cursor,routeIndex:i});if(state.mode==='current'&&['failure','recovery','repeat'].includes(state.scenario))edges.push({from:route[route.length-1],to:'retry',ghost:true,label:'proposed recovery'});if(state.mode!=='current'&&SCENARIOS.get(state.scenario).extra.includes('empty'))edges.push({from:'pending',to:'empty',ghost:true,label:'empty success'});if(state.mode!=='current'&&state.scenario==='repeat')edges.push({from:'pending',to:'success',ghost:true,label:'success branch'});return edges;}
function renderGraph(resetView=false){
 const world=$('graph-world'),ids=graphIds(),route=currentRoute(),selected=selectedNode(),visited=new Set(route.slice(0,state.cursor+1));world.replaceChildren();state.positions=new Map();
 ids.forEach((id,i)=>state.positions.set(id,{x:28,y:22+i*64,w:264,h:48}));state.graphWidth=330;state.graphHeight=ids.length*64+28;
 for(const edge of graphEdges()){
  const a=state.positions.get(edge.from),b=state.positions.get(edge.to);if(!a||!b)continue;
  let d;const backwards=b.y<=a.y;
  if(backwards){const side=10;d=`M ${a.x} ${a.y+30} C ${side-12} ${a.y+30}, ${side-12} ${b.y+30}, ${b.x} ${b.y+30}`;}
  else if(b.y>a.y+75){const side=317;d=`M ${a.x+a.w} ${a.y+30} C ${side} ${a.y+30}, ${side} ${b.y+30}, ${b.x+b.w} ${b.y+30}`;}
  else{const cx=a.x+a.w/2;d=`M ${cx} ${a.y+a.h} C ${cx} ${a.y+a.h+15}, ${cx} ${b.y-15}, ${cx} ${b.y}`;}
  const kind=['error','blocked'].includes(edge.to)?'failure':['retry','success','review','empty'].includes(edge.to)?'recovery':'';
  world.append(makeSVG('path',{d,class:`edge ${kind} ${edge.traversed?'traversed':''} ${edge.ghost?'hypothesis':''}`,'data-from':edge.from,'data-to':edge.to,'data-step':edge.routeIndex??'branch','marker-end':edge.traversed?'url(#arrow-active)':'url(#arrow)'}));
  if(edge.label)world.append(makeSVG('text',{x:36,y:b.y-12,class:'edge-label'},edge.label));
 }
 ids.forEach((id,i)=>{
  const node=NODES.get(id),p=state.positions.get(id),onRoute=route.includes(id),isActive=id===selected.id;
  const g=makeSVG('g',{transform:`translate(${p.x} ${p.y})`,class:`flow-node ${node.kind} ${isActive?'active':''} ${visited.has(id)?'visited':''} ${!onRoute?'ghost':''}`,role:'button',tabindex:0,'data-node':id,'aria-label':node.title+(node.proposedOnly?' (proposed, not applied)':''),'aria-pressed':isActive,'aria-current':isActive?'step':'false',opacity:isActive?1:onRoute?visited.has(id)?.96:.72:.35});
  g.append(makeSVG('rect',{width:p.w,height:p.h,rx:7,class:'body'}));g.append(makeSVG('text',{x:12,y:20,class:'node-number'},String(i+1).padStart(2,'0')));g.append(makeSVG('circle',{cx:p.w-15,cy:18,r:3,class:'node-dot'}));g.append(makeSVG('text',{x:39,y:23,class:'node-title'},(graphLabels[id]||node.title)));g.append(makeSVG('text',{x:39,y:39,class:'node-subtitle'},node.proposedOnly?'PROPOSED · NOT APPLIED':node.subtitle.split(' · ')[0].toUpperCase()));
  g.addEventListener('click',()=>selectNode(id));g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();selectNode(id);}});world.append(g);
 });
 $('graph-kind').textContent=state.scenario==='evidence'?'EVIDENCE ROUTE':state.mode==='current'?'CURRENT PATH':'PROPOSED PATH';$('step-count').textContent=`${String(state.cursor+1).padStart(2,'0')} / ${String(route.length).padStart(2,'0')}`;$('previous').disabled=state.cursor===0;$('next').disabled=state.cursor===route.length-1;
 if(resetView)requestAnimationFrame(()=>{initialGraphView();keepSelectedLegible();});else{keepSelectedLegible();applyTransform();}
}
function applyTransform(){$('graph-world').setAttribute('transform',`translate(${state.x} ${state.y}) scale(${state.zoom})`);$('zoom-label').textContent=Math.round(state.zoom*100)+'%';}
function fitGraph(){const r=$('graph-svg').getBoundingClientRect();if(!r.width||!r.height)return;state.zoom=Math.min((r.width-22)/state.graphWidth,(r.height-66)/state.graphHeight,1.18);state.zoom=Math.max(.2,state.zoom);state.x=(r.width-state.graphWidth*state.zoom)/2;state.y=Math.max(12,(r.height-46-state.graphHeight*state.zoom)/2);applyTransform();}
function initialGraphView(){fitGraph();if(innerWidth<=700&&state.zoom<.8){const r=$('graph-svg').getBoundingClientRect();state.zoom=.82;state.x=(r.width-state.graphWidth*state.zoom)/2;const p=state.positions.get(selectedNode().id);state.y=Math.max(14,Math.min(r.height/2-(p.y+p.h/2)*state.zoom,18-p.y*state.zoom));ensureMobileSelection();applyTransform();}}
function ensureMobileSelection(){if(innerWidth>700)return;const r=$('graph-svg').getBoundingClientRect(),p=state.positions.get(selectedNode().id);if(!p)return;const top=state.y+p.y*state.zoom,bottom=top+p.h*state.zoom;if(top<18||bottom>r.height-55)state.y=r.height/2-(p.y+p.h/2)*state.zoom;}
function zoomAt(factor,x,y){const r=$('graph-svg').getBoundingClientRect();x=x??r.width/2;y=y??r.height/2;const previous=state.zoom,next=Math.max(.2,Math.min(2.7,previous*factor));state.x=x-(x-state.x)*next/previous;state.y=y-(y-state.y)*next/previous;state.zoom=next;applyTransform();}
function saveLocation(){try{history.replaceState(null,'','#'+[state.mode,state.scenario,selectedNode().id,state.cursor].join('/'));}catch{}}
function changeMode(mode){if(!['current','proposed','diff'].includes(mode))return;const oldId=selectedNode().id;state.mode=mode;const route=currentRoute();state.cursor=Math.max(0,route.indexOf(oldId));render(true);}
function changeScenario(id){if(!SCENARIOS.has(id))return;state.scenario=id;state.cursor=0;render(true);}
function selectNode(id){
 const node=NODES.get(id);if(!node)return;const previousMode=state.mode;
 if(node.proposedOnly&&state.mode==='current'){state.mode='proposed';state.scenario='recovery';toast('Switched to the unapplied proposal');}
 let route=currentRoute(),index=route.indexOf(id);
 if(index<0){const match=DATA.scenarios.find(s=>(state.mode==='current'?s.current:s.proposed).includes(id));if(match){state.scenario=match.id;route=currentRoute();index=route.indexOf(id);}}
 if(index>=0){const reset=previousMode!==state.mode||state.scenario!==$('scenario').value;state.cursor=index;render(reset);}
}
function step(delta){const next=state.cursor+delta;if(next>=0&&next<currentRoute().length){state.cursor=next;render();}}
function toast(message){$('toast').textContent=message;$('toast').classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('visible'),2300);}
function copyText(){return getCopyableCode();}
async function copyCode(){await copyLiteral(getCopyableCode());}
function showDialog(title,body){$('dialog-heading').textContent=title;$('dialog-body').innerHTML=body;$('info-dialog').showModal();}
function showHelp(){showDialog('Navigate the investigation',`<p>This offline investigation connects source excerpts, state transitions and recorded evidence. Graph steps illustrate the code; they do not run the Sotto application.</p><div class="shortcut-grid"><span>Previous / next execution step</span><span><kbd>←</kbd> <kbd>→</kbd></span><span>Current / Proposed / Diff</span><span><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></span><span>First / last step</span><span><kbd>Home</kbd> <kbd>End</kbd></span><span>Fit graph to view</span><kbd>F</kbd><span>Zoom at the graph centre</span><span><kbd>+</kbd> <kbd>−</kbd></span><span>Pan / zoom around the pointer</span><span>Drag / wheel</span><span>Open help / close dialog</span><span><kbd>?</kbd> <kbd>Esc</kbd></span></div><p>Select a node or choose a route. A proposed-only node switches to Proposed view. Diff compares the selected current excerpt with an illustrative, unapplied excerpt; P numbers are not repository line numbers.</p>${statusHelp()}<p>Share the HTML file itself. It contains its source evidence and task checkpoints; it uses no external dependencies, runtime API calls or telemetry. The complete task journal remains a separate file.</p>`);}
function exportEvidence(){const snapshot={issue:DATA.issue,sourceCommit:DATA.commit,sourceHashes:DATA.sourceHashes,artifactBuiltAt:DATA.builtAt,selected:{mode:state.mode,route:state.scenario,node:selectedNode().id},checkpoints:DATA.checkpoints,acceptanceCases:{status:'PENDING',items:DATA.acceptance},repairApplied:false,newRegressionTests:0};const blob=new Blob([JSON.stringify(snapshot,null,2)+'\n'],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='sotto-637-evidence.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Task-specific evidence exported');}
$('scenario').innerHTML=DATA.scenarios.map(s=>`<option value="${s.id}">${escapeHTML(s.label)}</option>`).join('');$('scenario').addEventListener('change',e=>changeScenario(e.target.value));$('source-commit').textContent=DATA.commit.slice(0,7);
document.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>changeMode(b.dataset.mode)));document.querySelectorAll('[data-context]').forEach(b=>b.addEventListener('click',()=>{state.context=b.dataset.context;render();}));
for(const group of ['.mode-tabs','.context-tabs'])document.querySelector(group).addEventListener('keydown',e=>{if(!['ArrowRight','ArrowLeft'].includes(e.key))return;e.preventDefault();e.stopPropagation();const buttons=[...e.currentTarget.querySelectorAll('[role=tab]')],index=buttons.indexOf(document.activeElement),next=(index+(e.key==='ArrowRight'?1:-1)+buttons.length)%buttons.length;buttons[next].focus();buttons[next].click();});
$('previous').addEventListener('click',()=>step(-1));$('next').addEventListener('click',()=>step(1));$('fit-view').addEventListener('click',fitGraph);$('zoom-in').addEventListener('click',()=>zoomAt(1.2));$('zoom-out').addEventListener('click',()=>zoomAt(1/1.2));$('copy-code').addEventListener('click',copyCode);$('wrap-code').addEventListener('click',()=>{state.wrap=!state.wrap;$('code-view').classList.toggle('wrap',state.wrap);$('wrap-code').setAttribute('aria-pressed',state.wrap);});$('help-button').addEventListener('click',showHelp);$('original-notes').addEventListener('click',()=>showDialog('Original visual walkthrough',`<p>The retained Markdown analysis is embedded below, unchanged. Proposed snippets remain unapplied.</p><pre>${escapeHTML(DATA.notes)}</pre>`));$('close-dialog').addEventListener('click',()=>$('info-dialog').close());$('info-dialog').addEventListener('click',e=>{if(e.target===$('info-dialog'))$('info-dialog').close();});$('export-evidence').addEventListener('click',exportEvidence);
const svg=$('graph-svg');svg.addEventListener('wheel',e=>{e.preventDefault();const r=svg.getBoundingClientRect();zoomAt(e.deltaY<0?1.12:1/1.12,e.clientX-r.left,e.clientY-r.top);},{passive:false});svg.addEventListener('pointerdown',e=>{if(e.target.closest('[data-node]')||e.button!==0)return;pan={x:e.clientX,y:e.clientY,oldX:state.x,oldY:state.y};svg.setPointerCapture(e.pointerId);svg.classList.add('dragging');});svg.addEventListener('pointermove',e=>{if(!pan)return;state.x=pan.oldX+e.clientX-pan.x;state.y=pan.oldY+e.clientY-pan.y;applyTransform();});function stopPan(){pan=null;svg.classList.remove('dragging');}svg.addEventListener('pointerup',stopPan);svg.addEventListener('pointercancel',stopPan);
document.addEventListener('keydown',e=>{if($('info-dialog').open)return;if(e.target.closest('input,textarea,select,[contenteditable=true]'))return;if(e.altKey||e.ctrlKey||e.metaKey)return;const modes={'1':'current','2':'proposed','3':'diff'};if(modes[e.key]){e.preventDefault();changeMode(modes[e.key]);}else if(e.key==='ArrowRight'){e.preventDefault();step(1);}else if(e.key==='ArrowLeft'){e.preventDefault();step(-1);}else if(e.key==='Home'){e.preventDefault();state.cursor=0;render();}else if(e.key==='End'){e.preventDefault();state.cursor=currentRoute().length-1;render();}else if(e.key.toLowerCase()==='f'||e.key==='0'){e.preventDefault();fitGraph();}else if(e.key==='+'||e.key==='='){e.preventDefault();zoomAt(1.2);}else if(e.key==='-'){e.preventDefault();zoomAt(1/1.2);}else if(e.key==='?'){e.preventDefault();showHelp();}});
new ResizeObserver(()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>{initialGraphView();keepSelectedLegible();},80);}).observe($('graph-canvas'));
function restoreHash(){const[mode,scenario,id,cursor]=location.hash.slice(1).split('/');if(['current','proposed','diff'].includes(mode))state.mode=mode;if(SCENARIOS.has(scenario))state.scenario=scenario;const route=currentRoute(),n=Number(cursor);state.cursor=Number.isInteger(n)&&n>=0&&n<route.length&&route[n]===id?n:Math.max(0,route.indexOf(id));}
/*__FOCUS_REFINEMENT__*/
restoreHash();render(true);window.addEventListener('hashchange',()=>{restoreHash();render(true);});
// Read-only diagnostics for independent source-mapping and interaction validation.
window.walkthrough=Object.freeze({getSnapshot:()=>({mode:state.mode,scenario:state.scenario,cursor:state.cursor,node:selectedNode().id,zoom:state.zoom,x:state.x,y:state.y,context:state.context}),getDisplayedText:copyText});
</script>
</body>
</html>
